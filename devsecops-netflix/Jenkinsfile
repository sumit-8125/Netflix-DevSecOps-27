kubernets test --------



pipeline{
    agent any
    tools{
        jdk 'jdk25'
        nodejs 'node25'
    }
    environment {
        SCANNER_HOME=tool 'sonar-scanner'
    }
    stages {
        stage('clean workspace'){
            steps{
                cleanWs()
            }
        }
        stage('Checkout from Git'){
            steps{
                git branch: 'main', url: 'https://github.com/sumit-8125/Netflix-DevSecOps-27.git'
            }
        }
        stage("Sonarqube Analysis "){
            steps{
                dir('devsecops-netflix') {
                withSonarQubeEnv('sonar-server') {
                    sh ''' $SCANNER_HOME/bin/sonar-scanner -Dsonar.projectName=netflix \
                    -Dsonar.projectKey=netflix '''
                }
            }
        }
    }
        stage("quality gate"){
           steps {
                script {
                    waitForQualityGate abortPipeline: false, credentialsId: 'sonar-token'
                }
            }
        }
        stage('Install Dependencies') {
            steps {
                dir('devsecops-netflix') {
                sh "npm install"
            }
        }
    }
        stage('TRIVY FS SCAN') {
            steps {
                dir('devsecops-netflix') {
                sh "trivy fs . > trivyfs.txt"
            }
        }
    }
        stage("Docker Build & Push"){
            steps{
                script{
                   withDockerRegistry(credentialsId: 'docker'){
                        dir('devsecops-netflix') {
                       sh "docker build --build-arg TMDB_V3_API_KEY=6472e0635fccf0b73e7eb0858b1277cd -t netflix ."
                       sh "docker tag netflix 08122005/netflix:latest "
                       sh "docker push 08122005/netflix:latest "
                    }
                }
            }
        }
    }
        stage("TRIVY"){
            steps{
                sh "trivy image 08122005/netflix:latest > trivyimage.txt"
            }
        }
       stage('Deploy to container'){
            steps{
                sh 'docker rm -f netflix 2>/dev/null || true'
                sh 'docker run -d --name netflix -p 3001:80 08122005/netflix:latest'
            }
        }
       stage('Deploy to kubernetes'){
            steps{
                script{
                    dir('devsecops-netflix/Kubernetes') {
                        withKubeConfig(caCertificate: '', clusterName: '', contextName: '', credentialsId: 'k8s', namespace: '', restrictKubeConfigAccess: false, serverUrl: '') {
                                sh 'kubectl apply -f deployment.yml'
                                sh 'kubectl apply -f service.yml'
                        }
                    }
                }
            }
        }

    }
}

